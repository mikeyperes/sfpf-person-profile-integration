<?xml version="1.0"?>
<ruleset name="SFPF Person Profile"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 https://pmd.github.io/schema/ruleset_1_0_0.xsd">
    <description>Maintainability rules for namespaced SFPF host modules.</description>

    <rule ref="rulesets/cleancode.xml">
        <exclude name="StaticAccess"/>
    </rule>
    <rule ref="rulesets/codesize.xml"/>
    <rule ref="rulesets/design.xml"/>
    <rule ref="rulesets/naming.xml"/>
    <rule ref="rulesets/unusedcode.xml"/>
    <rule ref="rulesets/controversial.xml">
        <exclude name="Superglobals"/>
    </rule>
</ruleset>
